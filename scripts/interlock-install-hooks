#!/usr/bin/env bash
set -euo pipefail

# interlock-install-hooks — Install interlock git hooks (pre-commit + post-commit).
# Handles existing hooks by detecting an INTERLOCK_HOOK_MARKER comment.

MARKER="# INTERLOCK_HOOK_MARKER"

GIT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "ERROR: Not inside a git repository." >&2
    exit 1
}

HOOKS_DIR="${GIT_ROOT}/.git/hooks"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Resolve template locations
if [[ -n "${INTERLOCK_ROOT:-}" ]]; then
    PRECOMMIT_TEMPLATE="${INTERLOCK_ROOT}/scripts/interlock-precommit-hook"
    POSTCOMMIT_TEMPLATE="${INTERLOCK_ROOT}/scripts/interlock-postcommit-hook"
else
    PRECOMMIT_TEMPLATE="${SCRIPT_DIR}/interlock-precommit-hook"
    POSTCOMMIT_TEMPLATE="${SCRIPT_DIR}/interlock-postcommit-hook"
fi

if [[ ! -f "$PRECOMMIT_TEMPLATE" ]]; then
    echo "ERROR: Pre-commit hook template not found at ${PRECOMMIT_TEMPLATE}" >&2
    exit 1
fi

mkdir -p "$HOOKS_DIR"

# --- Install pre-commit hook ---
install_hook() {
    local hook_name="$1"
    local template="$2"
    local hook_path="${HOOKS_DIR}/${hook_name}"
    local backup_path="${HOOKS_DIR}/${hook_name}.interlock-backup"

    if [[ ! -f "$template" ]]; then
        echo "SKIP: ${hook_name} template not found at ${template}" >&2
        return 0
    fi

    if [[ -f "$hook_path" ]]; then
        if grep -q "$MARKER" "$hook_path" 2>/dev/null; then
            echo "Replacing existing interlock ${hook_name} hook..."
            cp "$template" "$hook_path"
            chmod +x "$hook_path"
            echo "  Updated at ${hook_path}"
        else
            echo "Existing ${hook_name} hook detected. Backing up to ${backup_path}..."
            cp "$hook_path" "$backup_path"
            chmod +x "$backup_path"
            {
                echo "#!/usr/bin/env bash"
                echo "$MARKER"
                echo "# Wrapper: runs original hook first, then interlock."
                echo ""
                echo "if [[ -x \"${backup_path}\" ]]; then"
                echo "    \"${backup_path}\""
                echo "    ORIG_EXIT=\$?"
                echo "    if [[ \$ORIG_EXIT -ne 0 ]]; then"
                echo "        exit \$ORIG_EXIT"
                echo "    fi"
                echo "fi"
                echo ""
                tail -n +3 "$template"
            } > "$hook_path"
            chmod +x "$hook_path"
            echo "  Wrapper installed at ${hook_path}"
            echo "  Original preserved at ${backup_path}"
        fi
    else
        echo "Installing interlock ${hook_name} hook..."
        cp "$template" "$hook_path"
        chmod +x "$hook_path"
        echo "  Installed at ${hook_path}"
    fi
}

install_hook "pre-commit" "$PRECOMMIT_TEMPLATE"
install_hook "post-commit" "$POSTCOMMIT_TEMPLATE"

echo "Done. Interlock git hooks installed."
