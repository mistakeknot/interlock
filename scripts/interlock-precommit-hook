#!/usr/bin/env bash
# INTERLOCK_HOOK_MARKER
# interlock pre-commit hook — enforces intermute file reservations at commit time
# and serializes commits across sessions via lockfile.
# Skippable via: git commit --no-verify

# --- Graceful degradation: pass if agent not registered ---
if [[ -z "${INTERMUTE_AGENT_ID:-}" ]]; then
    exit 0
fi

# --- Configuration ---
INTERMUTE_SOCKET="${INTERMUTE_SOCKET:-/var/run/intermute.sock}"
INTERMUTE_URL="${INTERMUTE_URL:-http://127.0.0.1:7338}"
GIT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || GIT_ROOT=""
INTERMUTE_PROJECT="${INTERMUTE_PROJECT:-$(basename "$GIT_ROOT" 2>/dev/null)}"

if [[ -z "$INTERMUTE_PROJECT" || -z "$GIT_ROOT" ]]; then
    exit 0
fi

# --- Commit serialization via lockfile ---
# Multiple session worktrees still share a target branch/remote. Serialize
# commits so reservation checks and downstream pushes happen in a predictable
# order. We use a PID-based lockfile with spin-wait — simpler than flock across
# hooks.
COMMIT_LOCK="${GIT_ROOT}/.git/commit.lock"
LOCK_TIMEOUT=30
LOCK_ACQUIRED=false

acquire_commit_lock() {
    local start=$SECONDS
    while (( SECONDS - start < LOCK_TIMEOUT )); do
        # Try to create lockfile atomically (mkdir is atomic on all filesystems)
        if mkdir "${COMMIT_LOCK}.d" 2>/dev/null; then
            echo "$$" > "${COMMIT_LOCK}.d/pid"
            LOCK_ACQUIRED=true
            return 0
        fi
        # Check if holder is still alive
        local holder_pid
        holder_pid=$(cat "${COMMIT_LOCK}.d/pid" 2>/dev/null) || holder_pid=""
        if [[ -n "$holder_pid" ]] && ! kill -0 "$holder_pid" 2>/dev/null; then
            # Stale lock — holder died. Clean up and retry.
            rm -rf "${COMMIT_LOCK}.d" 2>/dev/null
            continue
        fi
        sleep 0.5
    done
    return 1
}

release_commit_lock() {
    if [[ "$LOCK_ACQUIRED" == "true" ]]; then
        rm -rf "${COMMIT_LOCK}.d" 2>/dev/null
        LOCK_ACQUIRED=false
    fi
}

# Release lock on any exit (success, failure, or signal)
trap release_commit_lock EXIT

if ! acquire_commit_lock; then
    echo "" >&2
    echo "ERROR: Commit lock timeout (${LOCK_TIMEOUT}s). Another session is committing." >&2
    echo "Wait and retry, or force with: git commit --no-verify" >&2
    echo "" >&2
    exit 1
fi

# --- Build curl args ---
CURL_BASE=(curl -sf --max-time 5)
if [[ -S "$INTERMUTE_SOCKET" ]]; then
    CURL_BASE+=(--unix-socket "$INTERMUTE_SOCKET")
    BASE_URL="http://localhost"
else
    BASE_URL="$INTERMUTE_URL"
fi

# --- Get staged files ---
STAGED_FILES=$(git diff --cached --name-only 2>/dev/null)
if [[ -z "$STAGED_FILES" ]]; then
    exit 0
fi

# --- Fetch active reservations ---
RESERVATIONS=$("${CURL_BASE[@]}" "${BASE_URL}/api/reservations?project=$(printf '%s' "$INTERMUTE_PROJECT" | jq -sRr @uri)" 2>/dev/null) || {
    # intermute unreachable — pass through
    exit 0
}

# --- Check each staged file ---
CONFLICTS=()

while IFS= read -r file; do
    [[ -z "$file" ]] && continue

    while IFS='|' read -r res_agent_id res_pattern res_reason res_expires res_active; do
        [[ "$res_active" != "true" ]] && continue
        [[ "$res_agent_id" == "$INTERMUTE_AGENT_ID" ]] && continue

        # Match file against glob pattern
        # shellcheck disable=SC2254
        case "$file" in
            $res_pattern)
                reason_str=""
                [[ -n "$res_reason" && "$res_reason" != "null" ]] && reason_str=": \"${res_reason}\""
                CONFLICTS+=("  - ${file} (reserved by ${res_agent_id}${reason_str})")
                break
                ;;
        esac
    done < <(echo "$RESERVATIONS" | jq -r '.reservations[]? | "\(.agent_id)|\(.path_pattern)|\(.reason // "")|\(.expires_at)|\(.is_active)"' 2>/dev/null)
done <<< "$STAGED_FILES"

# --- Report ---
if [[ ${#CONFLICTS[@]} -gt 0 ]]; then
    echo "" >&2
    echo "ERROR: Cannot commit. Reserved files detected:" >&2
    for conflict in "${CONFLICTS[@]}"; do
        echo "$conflict" >&2
    done
    echo "" >&2
    echo "Resolve: (1) /interlock:request-release, (2) wait for expiry, (3) git commit --no-verify (risk: overwrite)" >&2
    echo "" >&2
    exit 1
fi

# Lock is released by the EXIT trap when pre-commit hook exits.
# Since git commit is single-threaded (pre-commit → write → post-commit),
# the lock is held for the entire pre-commit check but NOT during the actual
# commit write. This is acceptable because:
#   1. The read-tree above ensures we have the latest HEAD
#   2. Git's own ref update is atomic (compare-and-swap)
#   3. If two commits race to update HEAD, git's ref lock handles it
exit 0
